SNOWFLAKE_USER=STREAMING_DEMO_USER
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/streaming_demo.p8
SNOWFLAKE_DATABASE=STREAMING_DEMO
SNOWFLAKE_SCHEMA=SECURITY
SNOWFLAKE_TABLE=CAMERA_EVENTS
SNOWFLAKE_ROLE=STREAMING_DEMO_ROLE
GENERATE_RATE_PER_SEC=20
